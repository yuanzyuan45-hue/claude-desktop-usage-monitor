{
  "manifest_version": "0.3",
  "name": "claude-usage-monitor",
  "display_name": "Claude 用量监控",
  "version": "1.2.1",
  "description": "从 Claude 桌面版本地缓存读取会话(5小时)/每周(7天)用量百分比与重置时间,免费账户可用,纯本地读取不联网。",
  "long_description": "非官方 Claude Desktop 扩展。官方界面不给免费用户显示额度,本扩展补上这块:托盘图标悬停即看 5 小时 / 每周用量与重置时间,或在对话中让 Claude 调用 claude_usage 工具。只读取 Claude 桌面版自己写在 %APPDATA%\\Claude\\IndexedDB 下的本地缓存,不联网、不需要 API Key、不碰聊天内容。",
  "author": {
    "name": "yuanzyuan45-hue",
    "url": "https://github.com/yuanzyuan45-hue"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuanzyuan45-hue/claude-desktop-usage-monitor"
  },
  "homepage": "https://github.com/yuanzyuan45-hue/claude-desktop-usage-monitor#readme",
  "support": "https://github.com/yuanzyuan45-hue/claude-desktop-usage-monitor/issues",
  "icon": "icon.png",
  "keywords": ["claude", "usage", "quota", "limits", "tray", "mcp"],
  "server": {
    "type": "python",
    "entry_point": "main.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "${__dirname}/main.py"
      ]
    }
  },
  "compatibility": {
    "platforms": ["win32"],
    "runtimes": {
      "python": ">=3.7"
    }
  },
  "tools": [
    {
      "name": "claude_usage",
      "description": "读取本机 Claude 桌面版缓存的用量:会话(5小时)与每周(7天)已用百分比、重置时间"
    }
  ],
  "license": "MIT"
}
